<!--
    The main window.

    It holds no decisions. Every question it asks is answered by MakeADisc,
    which has no WPF in it, so what is here is only arrangement: where things
    sit, what they are called, and which of them is bound to what.

    Everything an automated test touches carries an AutomationId, set here and
    never left to the framework to invent. v1 is WinForms and its window suite
    fought UI Automation the whole way, which is the single largest reason this
    is WPF.
-->
<!--
    CanMinimize rather than NoResize. Every position in this window is fixed,
    so a maximise button would be an invitation to break it, but NoResize takes
    the minimise button away as well, and a burn can take a quarter of an hour
    with this window sitting in front of everything else.
-->
<Window x:Class="DiscWright.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiscWright"
        Icon="DiscWright.ico"
        Loaded="ListenForDiscs"
        Height="740" Width="920"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}"
        FontFamily="{StaticResource Face}"
        AutomationProperties.AutomationId="TheWindow">

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================== the top line -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <!-- The version beside the name, not under the line about
                     discs: on its own underneath, "2.0.0" could as easily
                     have been about the disc being made. -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="DiscWright" Style="{StaticResource Title}" />

                    <TextBlock Style="{StaticResource Aside}"
                               Margin="8,0,0,3"
                               VerticalAlignment="Bottom"
                               Text="{Binding ThisBuild}"
                               AutomationProperties.AutomationId="ThisBuild" />
                </StackPanel>
                <TextBlock Style="{StaticResource Aside}"
                           Margin="0,2,0,0"
                           Text="Put a game on a disc that still works in ten years." />

                <!-- Barely an action, and it should not look like one. -->
                <Button Content="Check for a new version"
                        Style="{StaticResource Quietly}"
                        Margin="0,8,0,0"
                        Click="CheckForANewVersion"
                        AutomationProperties.AutomationId="CheckForANewVersion" />
            </StackPanel>

            <!-- About the whole window rather than about one more game, which
                 is why it sits up here and not beside Add a game. -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Button Content="Start a new disc"
                        Style="{StaticResource Ordinary}"
                        HorizontalAlignment="Stretch"
                        Click="StartANewDisc"
                        AutomationProperties.AutomationId="StartANewDisc" />

                <Button Content="Open one you built before..."
                        Style="{StaticResource Ordinary}"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0"
                        Click="OpenADisc"
                        AutomationProperties.AutomationId="OpenADisc" />

            </StackPanel>
        </Grid>

        <!-- ===================================================== the middle -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- What goes on it -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Step}" Text="WHAT GOES ON IT" />

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Add a game..."
                            Style="{StaticResource Ordinary}"
                            Click="AddAGame"
                            AutomationProperties.AutomationId="AddAGame" />
                    <Button Content="Remove"
                            Style="{StaticResource Ordinary}"
                            Margin="8,0,0,0"
                            Click="TakeItOff"
                            AutomationProperties.AutomationId="TakeItOff" />
                </StackPanel>

                <Border Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Edge}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <!-- Said once, on an empty list, and gone the moment
                             there is anything to show. -->
                        <TextBlock Style="{StaticResource Aside}"
                                   Margin="16"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding Games.Count, Converter={StaticResource WhenNone}}"
                                   AutomationProperties.AutomationId="NothingYet"
                                   Text="Nothing yet. Add the folder a game was downloaded into, or the folder it is installed in." />

                        <ListBox x:Name="Games"
                                 ItemsSource="{Binding Games}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.AutomationId="Games">
                            <!-- Without this a row answers to whatever the
                                 thing in it prints as, which here is the whole
                                 record: every file, every size. A reader would
                                 say all of it aloud, and a window test would
                                 see it instead of a name. -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,7">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />

                                        <!-- Trimmed rather than scrolled. A
                                             folder path is long, and a bar
                                             along the bottom of the list to
                                             read the end of one is a poor
                                             trade for the room it takes. -->
                                        <TextBlock Style="{StaticResource Aside}"
                                                   Text="{Binding Path}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- What it is called, and where it goes.

                 In a scroller because this column has twice grown past the
                 bottom of a window drawn for what was in it before, and both
                 times the answer was a taller window. A scrollbar appears only
                 when it is needed and nothing can be lost again. -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Step}" Text="WHAT IT IS CALLED" />
                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper"
                         MaxLength="32"
                         AutomationProperties.AutomationId="Label" />
                <TextBlock Style="{StaticResource Aside}"
                           Margin="0,5,0,0"
                           Text="What This PC shows when the disc goes in." />

                <TextBlock Style="{StaticResource Step}" Margin="0,16,0,6" Text="WHAT SIZE OF DISC" />
                <!-- What is actually in the tray, said under the size that
                     was asked for. A worry and never a refusal: planning a DVD
                     with last week's CD still in the drive is an ordinary thing
                     to be doing. -->
                <ComboBox ItemsSource="{Binding DiscSizes}"
                          SelectedItem="{Binding Medium}"
                          DisplayMemberPath="Name"
                          AutomationProperties.AutomationId="DiscSize">
                    <!-- DisplayMemberPath sets what is SHOWN, and nothing
                         else. Without this a row still answers to whatever
                         the thing in it prints as, which here is
                         "Medium { Key = CD, Name = CD-R 700 MB, Capacity =
                         730144440 }". A reader would say all of that aloud.
                         The same slip as the games list, in a second place. -->
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <TextBlock Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding AboutTheDiscInTheDrive}"
                           Visibility="{Binding AboutTheDiscInTheDrive, Converter={StaticResource WhenAnything}}"
                           AutomationProperties.AutomationId="AboutTheDiscInTheDrive">
                    <!-- The style goes here and not in Resources, and there is
                         no Style attribute as well. An implicit style sitting
                         in an element's own Resources applies to its children
                         and never to itself, and a Style attribute would win
                         over it anyway, so the trigger below would have been
                         dead markup that looked right. -->
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Aside}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TheDiscIsADifferentSize}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WorryInk}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Whether this needs somebody in the room. Said here, before
                     anything is written, because said afterwards it is said to
                     an empty chair. -->
                <TextBlock Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource WorryInk}"
                           Text="{Binding AboutTheTray}"
                           Visibility="{Binding AboutTheTray, Converter={StaticResource WhenAnything}}"
                           AutomationProperties.AutomationId="AboutTheTray" />

                <TextBlock Style="{StaticResource Step}" Margin="0,16,0,6" Text="WHERE IT GOES" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="OutputFolder" />
                    <Button Grid.Column="1"
                            Content="Browse..."
                            Style="{StaticResource Ordinary}"
                            Margin="8,0,0,0"
                            Click="ChooseWhereItGoes"
                            AutomationProperties.AutomationId="ChooseWhereItGoes" />
                </Grid>

                <TextBlock Style="{StaticResource Aside}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Text="The disc is built into a folder here, with its ISO beside it. Nothing is written to a disc until you press Burn."
                           AutomationProperties.AutomationId="WhatGoesThere" />

                <!-- Everything that is not a game. All of it has worked in
                     the build pipeline from the start and none of it had a way
                     in from this window, so a disc made here could not have a
                     background, an icon, music, a manual or extras on it. -->
                <Expander Margin="0,16,0,0"
                          Foreground="{StaticResource Quiet}"
                          FontSize="12"
                          Header="What else goes on it"
                          AutomationProperties.AutomationId="WhatElseGoesOnIt">
                    <StackPanel Margin="4,4,0,0">
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Text="Disc icon" />

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DiscIcon}"
                                       Text="{Binding DiscIcon, TargetNullValue=nothing chosen}"
                                       AutomationProperties.AutomationId="TheDiscIcon" />

                            <Button Grid.Column="2"
                                    Content="Choose..."
                                    Style="{StaticResource Quietly}"
                                    VerticalAlignment="Center"
                                    Click="ChooseTheDiscIcon"
                                    AutomationProperties.AutomationId="ChooseTheDiscIcon" />
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Text="Background" />

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Background}"
                                       Text="{Binding Background, TargetNullValue=nothing chosen}"
                                       AutomationProperties.AutomationId="TheBackground" />

                            <Button Grid.Column="2"
                                    Content="Choose..."
                                    Style="{StaticResource Quietly}"
                                    VerticalAlignment="Center"
                                    Click="ChooseTheBackground"
                                    AutomationProperties.AutomationId="ChooseTheBackground" />
                        </Grid>

                        <CheckBox Margin="96,4,0,0"
                                  Content="Stretch it to fit rather than cropping"
                                  IsChecked="{Binding BackgroundAsIs}"
                                  AutomationProperties.AutomationId="BackgroundAsIs" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Text="Music" />

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Music}"
                                       Text="{Binding Music, TargetNullValue=nothing chosen}"
                                       AutomationProperties.AutomationId="TheMusic" />

                            <Button Grid.Column="2"
                                    Content="Choose..."
                                    Style="{StaticResource Quietly}"
                                    VerticalAlignment="Center"
                                    Click="ChooseTheMusic"
                                    AutomationProperties.AutomationId="ChooseTheMusic" />
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Text="Manual" />

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Manual}"
                                       Text="{Binding Manual, TargetNullValue=nothing chosen}"
                                       AutomationProperties.AutomationId="TheManual" />

                            <Button Grid.Column="2"
                                    Content="Choose..."
                                    Style="{StaticResource Quietly}"
                                    VerticalAlignment="Center"
                                    Click="ChooseTheManual"
                                    AutomationProperties.AutomationId="ChooseTheManual" />
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Text="Extras" />

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ExtrasFolder}"
                                       Text="{Binding ExtrasFolder, TargetNullValue=nothing chosen}"
                                       AutomationProperties.AutomationId="TheExtrasFolder" />

                            <Button Grid.Column="2"
                                    Content="Choose..."
                                    Style="{StaticResource Quietly}"
                                    VerticalAlignment="Center"
                                    Click="ChooseTheExtras"
                                    AutomationProperties.AutomationId="ChooseTheExtras" />
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Text="Cover" />

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Cover}"
                                       Text="{Binding Cover, TargetNullValue=nothing chosen}"
                                       AutomationProperties.AutomationId="TheCover" />

                            <Button Grid.Column="2"
                                    Content="Choose..."
                                    Style="{StaticResource Quietly}"
                                    VerticalAlignment="Center"
                                    Click="ChooseTheCover"
                                    AutomationProperties.AutomationId="ChooseTheCover" />
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Text="Disc face" />

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Aside}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DiscFace}"
                                       Text="{Binding DiscFace, TargetNullValue=nothing chosen}"
                                       AutomationProperties.AutomationId="TheDiscFace" />

                            <Button Grid.Column="2"
                                    Content="Choose..."
                                    Style="{StaticResource Quietly}"
                                    VerticalAlignment="Center"
                                    Click="ChooseTheDiscFace"
                                    AutomationProperties.AutomationId="ChooseTheDiscFace" />
                        </Grid>

                        <TextBlock Style="{StaticResource Aside}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="The cover and the disc face are for printing. Everything above them goes on the disc."
                                   AutomationProperties.AutomationId="AboutTheArtwork" />

                        <TextBlock Foreground="{StaticResource WorryInk}"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding WhyNotThatPicture}"
                                   Visibility="{Binding WhyNotThatPicture, Converter={StaticResource WhenAnything}}"
                                   AutomationProperties.AutomationId="WhyNotThatPicture" />
                    </StackPanel>
                </Expander>

                <Expander Margin="0,16,0,0"
                          Foreground="{StaticResource Quiet}"
                          FontSize="12"
                          Header="More options"
                          AutomationProperties.AutomationId="MoreOptions">
                    <StackPanel Margin="4,10,0,0">
                        <!-- On by default, and the only option here whose
                             effect depends on a setting that is not ours. The
                             tooltip says so, because a disc that does nothing
                             when it goes in looks broken, and the reason is on
                             the other person's machine. -->
                        <CheckBox Content="A menu that opens when the disc goes in"
                                  IsChecked="{Binding Menu}"
                                  AutomationProperties.AutomationId="Menu">
                            <CheckBox.ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="360">
                                    A disc opens its menu by itself only where AutoRun is switched on, and
                                    Windows has been turning that off for years. Where it is off, the disc
                                    opens in Explorer instead and the menu is the AUTORUN folder.
                                </TextBlock>
                            </CheckBox.ToolTip>
                        </CheckBox>

                        <!-- Beside the option it is about. Previewing a menu
                             nobody asked for would be showing something that
                             is not going to be on the disc. -->
                        <Button Content="See what it will look like"
                                Style="{StaticResource Quietly}"
                                Margin="22,4,0,2"
                                IsEnabled="{Binding CanPreview}"
                                Click="PreviewTheMenu"
                                AutomationProperties.AutomationId="PreviewTheMenu" />

                        <CheckBox Content="A list of what every file should be"
                                  IsChecked="{Binding Checksums}"
                                  AutomationProperties.AutomationId="Checksums" />
                        <CheckBox Content="The cover art on the disc as well"
                                  IsChecked="{Binding ArtworkOnDisc}"
                                  AutomationProperties.AutomationId="ArtworkOnDisc" />
                        <CheckBox Content="Readable by Windows 98 and Mac OS 9"
                                  IsChecked="{Binding LegacyFileSystems}"
                                  AutomationProperties.AutomationId="LegacyFileSystems" />
                        <CheckBox Content="Split a file across two discs if it will not fit"
                                  IsChecked="{Binding CutFiles}"
                                  AutomationProperties.AutomationId="CutFiles" />
                    </StackPanel>
                </Expander>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================================================ the bottom line

             What it will make, anything worth saying about it, and the one
             button. The refusal lives here rather than in a dialog, because a
             refusal somebody reads before pressing anything is a sentence, and
             the same refusal after a click is a wasted decision.
        -->
        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Padding="18,14"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding WhatItWillMake}"
                               Visibility="{Binding IsWorking, Converter={StaticResource WhenNot}}"
                               AutomationProperties.AutomationId="WhatItWillMake" />

                    <!-- While it runs, the same line says what it is doing,
                         because that is the only thing anybody wants from it
                         then. -->
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding Doing}"
                               Visibility="{Binding IsWorking, Converter={StaticResource WhenSo}}"
                               AutomationProperties.AutomationId="Doing" />

                    <ProgressBar Height="14"
                                 Margin="0,10,0,0"
                                 Maximum="1"
                                 Value="{Binding HowFar, Mode=OneWay}"
                                 Visibility="{Binding IsWorking, Converter={StaticResource WhenSo}}"
                                 AutomationProperties.AutomationId="HowFar" />

                    <!-- What the two buttons actually mean. This program made
                         nothing but an ISO once, and the words outlasted that
                         by a long way: somebody reading "make the disc" has
                         every reason to think it burns one. -->
                    <TextBlock Style="{StaticResource Aside}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="Building puts the discs on this PC. Burning writes one to a real disc."
                               Visibility="{Binding IsWorking, Converter={StaticResource WhenNot}}"
                               AutomationProperties.AutomationId="WhatTheButtonsMean" />

                    <!-- Collapsed when there is nothing to say. An empty line
                         still takes the height of a line, and two of them were
                         most of the gap at the bottom of this window. -->
                    <TextBlock Foreground="{StaticResource RefusalInk}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding WhyNot.Headline}"
                               Visibility="{Binding WhyNot, Converter={StaticResource WhenAnything}}"
                               AutomationProperties.AutomationId="WhyNot" />

                    <TextBlock Foreground="{StaticResource WorryInk}"
                               FontSize="12"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding Worry.Headline}"
                               Visibility="{Binding Worry, Converter={StaticResource WhenAnything}}"
                               AutomationProperties.AutomationId="Worry" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Burn to a disc..."
                            Style="{StaticResource Ordinary}"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding CanBurn}"
                            Click="BurnIt"
                            AutomationProperties.AutomationId="BurnIt" />

                    <Button Content="Build it"
                            Style="{StaticResource TheButton}"
                            IsEnabled="{Binding CanMakeIt}"
                            Click="MakeTheDisc"
                            AutomationProperties.AutomationId="MakeTheDisc" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
