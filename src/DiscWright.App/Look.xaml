<!--
    Every colour, size and weight the window uses, in one place.

    Here rather than on the controls because a colour typed into twelve places
    is a colour that will be eleven places next time somebody changes it, and
    because the canvas the design was drawn on names these and nothing else.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The palette from the design canvas, and nothing beyond it. This is
         the light look; LookInTheDark.xaml answers for exactly these keys
         when Windows says apps are dark, which is why every reference to one
         of them is a DynamicResource: resolved statically it would be
         answered once, here, for ever. -->
    <SolidColorBrush x:Key="Ink" Color="#16191C" />
    <SolidColorBrush x:Key="Quiet" Color="#5B6871" />
    <SolidColorBrush x:Key="Accent" Color="#0E7C84" />
    <SolidColorBrush x:Key="AccentPressed" Color="#0A5F66" />
    <SolidColorBrush x:Key="Page" Color="#F4F5F6" />
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Edge" Color="#DEE2E4" />
    <SolidColorBrush x:Key="Dead" Color="#B9C0C4" />

    <!-- A refusal and a worry must not look the same. One stops the build and
         the other is only worth knowing. -->
    <SolidColorBrush x:Key="RefusalInk" Color="#A3302C" />
    <SolidColorBrush x:Key="WorryInk" Color="#8A5A00" />

    <!-- The words on the accent button. A brush rather than the word White,
         so the dark look could change its mind about it, and so no colour in
         this file is written where the palette cannot see it. -->
    <SolidColorBrush x:Key="InkOnAccent" Color="#FFFFFF" />

    <FontFamily x:Key="Face">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Background" Value="{DynamicResource Page}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Face}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Face}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="Step" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Face}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Quiet}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Aside" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Face}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Quiet}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Face}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Panel}" />
        <!-- Measured, not assumed, and twice. Bound to IsEnabled with no
             trigger here at all, the words stayed in #16191C, the same ink as
             a live one. A trigger setting Foreground did not help either: the
             theme draws the content through its own brush, so the colour on
             the control never reaches the words inside it.

             Opacity does, because it is applied to the whole control and
             nothing within it can set it back. The same answer the list of
             games needs, for the same reason. -->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Face}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <!-- Our own box, not the theme's. Windows draws its checkbox from
             system colours that never heard of the palette, so in the dark
             look it stayed a white box on a dark panel, the one control still
             dressed for the wrong room. The box takes the accent when
             ticked, and the tree's third state, some of this but not all of
             it, is a smaller square of the same accent inside a resting box. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="15" Height="15"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Panel}"
                                BorderBrush="{DynamicResource Quiet}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Grid>
                                <Path x:Name="Tick"
                                      Visibility="Collapsed"
                                      Data="M 3 7.5 L 6 10.5 L 10.5 4"
                                      Stroke="{DynamicResource InkOnAccent}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Rectangle x:Name="Partly"
                                           Visibility="Collapsed"
                                           Margin="3.5"
                                           RadiusX="1" RadiusY="1"
                                           Fill="{DynamicResource Accent}" />
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="7,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Partly" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Measured, not assumed, and twice. Bound to IsEnabled with no
             trigger here at all, the words stayed in #16191C, the same ink as
             a live one. A trigger setting Foreground did not help either: the
             theme draws the content through its own brush, so the colour on
             the control never reaches the words inside it.

             Opacity does, because it is applied to the whole control and
             nothing within it can set it back. The same answer the list of
             games needs, for the same reason. -->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Face}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Background" Value="{DynamicResource Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
        <Setter Property="MinHeight" Value="30" />
        <!-- Our own chrome, not the theme's, and not as a preference: the
             default template paints itself from system colours whatever
             Background says, so both dropdowns sat on the dark page as two
             bright system-grey stripes. The shape is the Ordinary button's,
             because a closed dropdown is a button that opens a list. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Shape"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <Path HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,11,0"
                                              Data="M 0 0 L 4 4 L 8 0"
                                              Stroke="{DynamicResource Quiet}"
                                              StrokeThickness="1.5" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Page}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="10,0,30,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource Panel}"
                                    BorderBrush="{DynamicResource Edge}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,2,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Measured, not assumed, and twice. Bound to IsEnabled with no
             trigger here at all, the words stayed in #16191C, the same ink as
             a live one. A trigger setting Foreground did not help either: the
             theme draws the content through its own brush, so the colour on
             the control never reaches the words inside it.

             Opacity does, because it is applied to the whole control and
             nothing within it can set it back. The same answer the list of
             games needs, for the same reason. -->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        The list of what goes on the disc, when nothing may be changed on it.

        Opacity rather than a colour, because every row draws its own words in
        its own ink: the name, the size and the kind each carry a Style of
        their own, and a Foreground set here would lose to all three. Dimming
        the whole control cannot be beaten by anything inside it.

        The line under it that says what the lot comes to is a sibling rather
        than a child, so it stays readable while the list is held.

        The template is ours as well, and not as a preference: the theme's
        tree answers IsEnabled=False by painting its own background from
        system colours, over whatever Background says. Held while a build
        ran, the whole list went system grey under the dark look, light ink
        on a light panel, which is how this was found. A template with no
        such trigger has nothing to paint wrongly, and the dimming above is
        the whole of what being held looks like.
    -->
    <Style TargetType="TreeView">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Focusable="False"
                                      CanContentScroll="False"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A row of the list, drawn like a row of the dialogs: the chosen one
         wears the deeper paper and the short accent band, because the theme's
         row wears system brushes that never heard of the palette. Selected
         and unfocused it was the system's pale grey under our light ink,
         a row that could not be read in the dark look.

         The children indent by nineteen exactly, because every row gives its
         name back whatever the tree pushed it in by, at nineteen a level, and
         the sizes only line up if the markup and that arithmetic agree. The
         guard in TheTreeOfWhatGoesOnIt holds the rows to it and the markup
         test holds this file to it. -->
    <Style TargetType="TreeViewItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Row"
                                Background="Transparent"
                                CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="19" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Rectangle x:Name="Chosen"
                                           Width="3"
                                           HorizontalAlignment="Left"
                                           Margin="0,4"
                                           RadiusX="1.5" RadiusY="1.5"
                                           Fill="{DynamicResource Accent}"
                                           Visibility="Collapsed" />

                                <!-- The opener, hidden rather than collapsed
                                     on a row with nothing under it, so the
                                     names start in one column either way. -->
                                <ToggleButton x:Name="Opener"
                                              ClickMode="Press"
                                              Focusable="False"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path x:Name="Arrow"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="{DynamicResource Quiet}"
                                                      StrokeThickness="1.5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="-90" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ItemsPresenter x:Name="Inside"
                                        Margin="19,0,0,0"
                                        Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Inside" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Opener" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Page}" />
                            <Setter TargetName="Chosen" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An ordinary button: the things somebody does on the way. -->
    <!-- Every button in the program is this shape. The one that matters wears
         the accent colour and a heavier weight, and is otherwise the same size,
         because a button that is both bigger and brighter than its neighbour
         looks like a different kind of thing rather than a louder one. -->
    <!--
        For the version line: pressable, and no heavier on the page than the
        quiet sentence above it. The same size and the same grey as Aside,
        because it sits directly under one and two greys a pixel apart look
        like a mistake rather than a distinction. The hand and the underline
        on hover are the whole of what says it can be pressed.
    -->
    <Style x:Key="Quietly" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Face}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Quiet}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Words"
                               Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}"
                               FontFamily="{TemplateBinding FontFamily}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Words" Property="TextDecorations" Value="Underline" />
                            <Setter TargetName="Words" Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>

                        <!-- After the hover, so it wins: IsMouseOver stays
                             true over a disabled button, and a dead link
                             underlined in the accent colour is the loudest
                             thing on the window.

                             Inside the template and naming the TextBlock it
                             paints, because a Setter here with no TargetName
                             loses to the Style's own Foreground setter and
                             reads exactly as though it works. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Words" Property="Foreground" Value="{DynamicResource Dead}" />
                            <Setter TargetName="Words" Property="TextDecorations" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- After the setters, not among them. A property element in the
             middle of an element's content is not markup WPF will compile,
             and no guard here would have seen it: these read the XAML as XML,
             and XML is perfectly happy with it. The app simply would not
             have opened. -->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A link that reads as a link before it is hovered: the accent ink
         is what says it can be pressed. Quietly above is for a pressable
         line that must not be louder than the sentence it sits under; this
         is for one that was being missed, the owner's words on 2026-11-09
         about Take it off the list sitting quiet in its corner. The
         underline still waits for the hover, because an underline at rest
         beside ordinary text reads as emphasis rather than as a control.
         Everything else, the hand, the hover, the dead grey when it cannot
         be pressed, is Quietly's. -->
    <Style x:Key="AsALink" TargetType="Button" BasedOn="{StaticResource Quietly}">
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- The cross at a row's right edge that takes the row off the list.
         Hidden rather than collapsed while the mouse is elsewhere, so the
         row is the same width whether or not it is being looked at, and
         shown for the header under the mouse, not for every ancestor of
         it: the binding reads the Border each row's template wraps its own
         header in, because the TreeViewItem itself is over its children
         too, and hovering one file would light the cross on every row
         above it. -->
    <Style x:Key="OffTheRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Visibility" Value="Hidden" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <Path x:Name="Cross"
                              Data="M 0 0 L 7 7 M 7 0 L 0 7"
                              Stroke="{DynamicResource Quiet}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cross" Property="Stroke" Value="{DynamicResource Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Ordinary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Face}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Background" Value="{DynamicResource Panel}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shape"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Edge}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <!-- Bound, not fixed. Centre is still the answer for
                             almost every button here, and a button that is as
                             wide as a column reads better with its words at
                             the edge the labels start at. -->
                        <!-- A TextBlock of our own, not a bare
                             ContentPresenter, and this is not a style
                             preference.

                             ContentPresenter makes its own TextBlock for
                             string content, and that TextBlock picks up the
                             implicit TextBlock style at the top of this
                             file, which sets Foreground to Ink. A style
                             setter beats an inherited value, so the
                             button's own Foreground never reached its own
                             words: setting it to Red changed nothing on
                             screen, which is how this was found. Quietly
                             below has always done it this way. -->
                        <TextBlock x:Name="Words"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   TextWrapping="NoWrap"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="Center"
                                   Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Page}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- Out here, not in the template above, and this is the whole point
             of it.

             A template trigger loses to the style's own Foreground setter
             nine lines up, so the greying was dead markup that read as if it
             worked. Remove and Burn to a disc were disabled and drew their
             words in #16191C, the same ink as the live button beside them,
             measured off a photograph of the window. A style trigger beats a
             style setter and this one takes.

             The cursor goes with it. A hand over a button that cannot be
             pressed is the same lie told a second way. -->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Dead}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The one button that makes the thing. There is exactly one on the
         window, and it is the only thing wearing the accent colour. -->
    <Style x:Key="TheButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Face}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource InkOnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shape"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <!-- Bound, not fixed. Centre is still the answer for
                             almost every button here, and a button that is as
                             wide as a column reads better with its words at
                             the edge the labels start at. -->
                        <!-- A TextBlock of our own, not a bare
                             ContentPresenter, and this is not a style
                             preference.

                             ContentPresenter makes its own TextBlock for
                             string content, and that TextBlock picks up the
                             implicit TextBlock style at the top of this
                             file, which sets Foreground to Ink. A style
                             setter beats an inherited value, so the
                             button's own Foreground never reached its own
                             words: setting it to Red changed nothing on
                             screen, which is how this was found. Quietly
                             below has always done it this way. -->
                        <TextBlock x:Name="Words"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   TextWrapping="NoWrap"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="Center"
                                   Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentPressed}" />
                        </Trigger>
                        <!-- Dead rather than hidden, so somebody can see what
                             they are working towards.

                             The background is named, so it reaches the Border
                             and takes. The cursor used to sit here too, with
                             no name on it, which put it up against this
                             style's own Cursor setter and lost: the one
                             button that greys properly still offered a hand
                             to press it with. It is below now. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Dead}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <!-- The words as well as the background. White on the dead
                     grey is barely there, and it only looked right before
                     because the colour was never reaching the text and it
                     came out in full ink by accident. Quiet is muted enough
                     to read as dead and dark enough to still be read. -->
                <Setter Property="Foreground" Value="{DynamicResource Quiet}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A row in a dropdown. Ours because the dropdown is ours now, and the
         default row paints its highlight from system colours. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Page}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row somebody picks one of. The chosen one wears a short band of
         the accent at its left edge as well as the deeper paper, because on
         the dialogs that use this the choice is the whole question and a
         shade of grey alone is a quiet answer to a loud one. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row"
                            Background="Transparent"
                            CornerRadius="3">
                        <Grid>
                            <Rectangle x:Name="Chosen"
                                       Width="3"
                                       HorizontalAlignment="Left"
                                       Margin="1,4"
                                       RadiusX="1.5" RadiusY="1.5"
                                       Fill="{DynamicResource Accent}"
                                       Visibility="Collapsed" />
                            <ContentPresenter Margin="6,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Page}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Page}" />
                            <Setter TargetName="Chosen" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The drawer under More options. Ours because the default header glyph
         is a circle drawn in system colours, the one light coin left on a
         dark window. The words are drawn by name, the way Quietly draws its
         own, because the implicit TextBlock style would otherwise beat the
         Foreground somebody set on the Expander itself. -->
    <Style TargetType="Expander">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton Focusable="False"
                                      Cursor="Hand"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <Path x:Name="Arrow"
                                              Data="M 0 0 L 4 4 L 8 0"
                                              Stroke="{DynamicResource Quiet}"
                                              StrokeThickness="1.5"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="-90" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <TextBlock Margin="7,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                   FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="0" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Opened" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Opened" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- What hovering says, on the palette's paper rather than the system's. -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Face}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Background" Value="{DynamicResource Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <!-- The scrollbars, slimmed to a thumb. The system ones are drawn from
         system colours and arrive full width with arrow buttons, which on
         this window means a broad light gutter down a dark panel. A track
         that can still be clicked to page, a thumb that can be dragged, and
         nothing else. -->
    <ControlTemplate x:Key="APageOfNothing" TargetType="RepeatButton">
        <Border Background="Transparent" />
    </ControlTemplate>

    <ControlTemplate x:Key="TheThumb" TargetType="Thumb">
        <Border Background="{DynamicResource Dead}" CornerRadius="4" Margin="2" />
    </ControlTemplate>

    <ControlTemplate x:Key="SlimUpAndDown" TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Template="{StaticResource APageOfNothing}" />
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Template="{StaticResource APageOfNothing}" />
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
                <Thumb Template="{StaticResource TheThumb}" />
            </Track.Thumb>
        </Track>
    </ControlTemplate>

    <ControlTemplate x:Key="SlimAlong" TargetType="ScrollBar">
        <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageLeftCommand" Template="{StaticResource APageOfNothing}" />
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageRightCommand" Template="{StaticResource APageOfNothing}" />
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
                <Thumb Template="{StaticResource TheThumb}" />
            </Track.Thumb>
        </Track>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource SlimUpAndDown}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template" Value="{StaticResource SlimAlong}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
