<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DiscWright.ViewModels\DiscWright.ViewModels.csproj" />
    <ProjectReference Include="..\DiscWright.Platform\DiscWright.Platform.csproj" />
    <ProjectReference Include="..\DiscWright.Imaging\DiscWright.Imaging.csproj" />
    <ProjectReference Include="..\DiscWright.Burning\DiscWright.Burning.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- v1's icon, which is a proper set from 16 up to 256, so the title bar,
         the taskbar, the Start menu and the file in Explorer all get one that
         was drawn for the size they show it at. -->
    <ApplicationIcon>DiscWright.ico</ApplicationIcon>

    <!-- Per Monitor V2 and the rest of what the exe says about itself: see
         the file. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="DiscWright.ico" />
  </ItemGroup>

</Project>
