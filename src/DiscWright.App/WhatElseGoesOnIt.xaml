<!--
    Everything that goes on a disc and is not a game.

    A window of its own rather than another drawer in the main one. There are
    seven of these, most of them pictures, and a picture somebody chose is only
    really confirmed by seeing it again: squeezed into a column beside the
    games list they were twelve pixel grey labels with a link beside them,
    quieter than anything else on the screen, for the two things almost
    everybody sets.
-->
<Window x:Class="DiscWright.App.WhatElseGoesOnIt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DiscWright.Core;assembly=DiscWright.Core"
        Title="What else goes on it"
        Height="700" Width="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="DiscWright.ico"
        Background="{DynamicResource Page}"
        FontFamily="{StaticResource Face}"
        AutomationProperties.AutomationId="WhatElseGoesOnIt">

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource Title}" FontSize="17" Text="What else goes on it" />
            <TextBlock Style="{StaticResource Aside}"
                       Margin="0,3,0,0"
                       Text="None of it is required. A disc with none of this is still a disc." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">

                <!-- ============================================ the disc icon -->
                <TextBlock Style="{StaticResource Step}" Text="THE DISC ICON" />
                <TextBlock Style="{StaticResource Aside}"
                           Margin="0,2,0,6"
                           Text="What This PC shows for the disc, and what the menu wears." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Edge}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Image Source="{Binding DiscIcon, Converter={StaticResource APicture}}"
                               Stretch="Uniform"
                               Margin="3"
                               AutomationProperties.AutomationId="TheDiscIconPicture" />
                    </Border>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DiscIcon}"
                               Text="{Binding DiscIcon, TargetNullValue=Nothing chosen}"
                               AutomationProperties.AutomationId="TheDiscIcon" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Choose"
                                Style="{StaticResource Ordinary}"
                                Click="ChooseTheDiscIcon"
                                AutomationProperties.AutomationId="ChooseTheDiscIcon" />
                        <Button Content="Clear"
                                Style="{StaticResource Ordinary}"
                                Margin="8,0,0,0"
                                Click="ClearTheDiscIcon"
                                AutomationProperties.AutomationId="ClearTheDiscIcon" />
                    </StackPanel>
                </Grid>

                <!-- =========================================== the background -->
                <TextBlock Style="{StaticResource Step}" Margin="0,22,0,0" Text="THE MENU BACKGROUND" />
                <TextBlock Style="{StaticResource Aside}"
                           Margin="0,2,0,6"
                           Text="The picture the menu is drawn on, at 760 by 480." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 190 by 120 inside its edge, a quarter of the menu
                         each way and exactly its shape, so what the frame
                         shows is what the menu keeps. -->
                    <Border Grid.Column="0" Width="196" Height="126"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Edge}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <!-- The colour, shown where the picture would
                                 be, because a backdrop somebody chose is
                                 only really confirmed by seeing it. Never
                                 both: choosing either takes the other off. -->
                            <!-- No AutomationId: a Border has no automation
                                 peer, so an id here would name a thing no
                                 test can ever reach. Checked by eye. -->
                            <Border Margin="2"
                                    CornerRadius="3"
                                    Background="{Binding BackgroundColour, Converter={StaticResource AsABrush}}"
                                    Visibility="{Binding BackgroundColour, Converter={StaticResource WhenAnything}}" />
                            <Image Source="{Binding Background, Converter={StaticResource APicture}}"
                                   Stretch="UniformToFill"
                                   Margin="2"
                                   Visibility="{Binding TheBackgroundCanBeFramed, Converter={StaticResource WhenNot}}"
                                   AutomationProperties.AutomationId="TheBackgroundPicture" />

                            <!-- The frame: the part of the picture the menu
                                 keeps, and the picture is dragged under it.
                                 Reddit, 20 November 2026. Only when it is
                                 filled and cropped, the one way to fit that
                                 leaves any of the picture out by choice.
                                 A Border has no automation peer, so the
                                 dragging is checked by eye and by hand; the
                                 arrow keys move it too, and the sum behind
                                 both is the suite's. -->
                            <Border x:Name="TheFrame"
                                    Margin="2"
                                    Cursor="SizeAll"
                                    Focusable="True"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="Drag the picture to choose the part the menu keeps"
                                    Visibility="{Binding TheBackgroundCanBeFramed, Converter={StaticResource WhenSo}}"
                                    MouseLeftButtonDown="TakeHoldOfThePicture"
                                    MouseMove="DragThePicture"
                                    MouseLeftButtonUp="LetGoOfThePicture"
                                    LostMouseCapture="ThePictureWasLetGo"
                                    MouseWheel="ZoomWithTheWheel"
                                    KeyDown="NudgeThePicture">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Background, Converter={StaticResource APicture}, ConverterParameter=480}"
                                                Viewbox="{Binding WhatTheMenuKeeps, Converter={StaticResource AsARect}}"
                                                ViewboxUnits="RelativeToBoundingBox"
                                                Stretch="Fill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                        <TextBlock TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Background}"
                                   Text="{Binding Background, TargetNullValue=Nothing chosen}"
                                   AutomationProperties.AutomationId="TheBackground" />

                        <!-- Four ways and not a tick box, discwright#98,
                             15 November: fill, fit, stretch and tile. The
                             line under it says what the one chosen does. -->
                        <ComboBox Margin="0,8,0,0"
                                  HorizontalAlignment="Left"
                                  MinWidth="150"
                                  ItemsSource="{Binding TheWaysABackgroundFits}"
                                  SelectedItem="{Binding HowTheBackgroundFits}"
                                  DisplayMemberPath="InWords"
                                  AutomationProperties.AutomationId="BackgroundFit">
                            <ComboBox.ItemContainerStyle>
                                <!-- BasedOn, so the rows keep the themed
                                     look, and named, so a reader says the
                                     words and not what the row prints as. -->
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding InWords}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <TextBlock Style="{StaticResource Aside}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding WhatThatFitDoes}"
                                   AutomationProperties.AutomationId="WhatThatFitDoes" />

                        <!-- Which part is kept, for a picture filled and
                             cropped. Gone for the other three ways and for
                             a colour, where there is no part to choose. -->
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding TheBackgroundCanBeFramed, Converter={StaticResource WhenSo}}">
                            <TextBlock Style="{StaticResource Aside}"
                                       TextWrapping="Wrap"
                                       Text="Drag the picture to choose the part that is kept." />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Zoom" />
                                <Slider Width="120"
                                        VerticalAlignment="Center"
                                        Minimum="1"
                                        Maximum="{x:Static core:KeptPart.MostZoom}"
                                        SmallChange="0.1"
                                        LargeChange="0.5"
                                        Value="{Binding BackgroundZoom}"
                                        AutomationProperties.Name="Zoom into the background"
                                        AutomationProperties.AutomationId="BackgroundZoom" />
                                <Button Content="Centre"
                                        Style="{StaticResource Ordinary}"
                                        Margin="10,0,0,0"
                                        IsEnabled="{Binding TheBackgroundIsFramed}"
                                        Click="KeepTheMiddle"
                                        AutomationProperties.AutomationId="CentreTheBackground" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Choose"
                                Style="{StaticResource Ordinary}"
                                Click="ChooseTheBackground"
                                AutomationProperties.AutomationId="ChooseTheBackground" />
                        <Button Content="Clear"
                                Style="{StaticResource Ordinary}"
                                Margin="8,0,0,0"
                                Click="ClearTheBackground"
                                AutomationProperties.AutomationId="ClearTheBackground" />
                    </StackPanel>
                </Grid>

                <!-- A colour instead of a picture, discwright#98: "a solid
                     color option by choosing a hex value". Swatches for the
                     colours that suit the panel, a box for any other, and
                     choosing either backdrop takes the other off. No
                     picture and no colour is itself a look: the menu's own
                     dark stage. -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock VerticalAlignment="Center" Text="Or a colour instead" />

                    <ItemsControl ItemsSource="{Binding TheColoursOffered}"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="TheColoursOffered">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Its own flat template, because a stock
                                     button's chrome would paint over the one
                                     thing a swatch is: the colour itself. -->
                                <Button Click="PickAColour"
                                        Cursor="Hand"
                                        ToolTip="{Binding}"
                                        AutomationProperties.Name="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Width="22" Height="22"
                                                    Margin="0,0,6,0"
                                                    CornerRadius="3"
                                                    Background="{Binding Converter={StaticResource AsABrush}}"
                                                    BorderBrush="{DynamicResource Edge}"
                                                    BorderThickness="1" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox Width="86"
                             Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             Text="{Binding BackgroundColourText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Six hex figures, with or without the #."
                             AutomationProperties.AutomationId="BackgroundColourText" />
                </StackPanel>

                <TextBlock Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WorryInk}"
                           Text="{Binding WhatTheColourSays}"
                           Visibility="{Binding WhatTheColourSays, Converter={StaticResource WhenAnything}}"
                           AutomationProperties.AutomationId="WhatTheColourSays" />

                <!-- ============================================== the layout -->
                <!-- discwright#98, 16 November: the list on the left or the
                     right, so a logo in one side of the picture is not under
                     it. The small buttons take the other side, and the line
                     underneath says where that leaves them. -->
                <TextBlock Style="{StaticResource Step}" Margin="0,22,0,0" Text="THE MENU'S LAYOUT" />

                <!-- The heading, discwright#98, 12 November: the disc's name
                     is what This PC shows, and what is written across the
                     top of the menu need not be the same words, or there at
                     all when the picture already carries the title. -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Heading" />
                    <TextBox Grid.Column="1"
                             VerticalAlignment="Center"
                             MaxLength="60"
                             Text="{Binding MenuHeading, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding MenuHeadingCanBeTyped}"
                             ToolTip="What the main menu is headed with. Left empty, it is the disc's name, or the game's on a disc of one."
                             AutomationProperties.AutomationId="MenuHeading" />
                </Grid>

                <CheckBox Margin="0,8,0,0"
                          Content="No heading on the main menu"
                          IsChecked="{Binding MenuHeadingHidden}"
                          ToolTip="For a picture that already has the title in it. A game's own screen on a disc of several keeps the game's name."
                          AutomationProperties.AutomationId="MenuHeadingHidden" />

                <CheckBox Margin="0,8,0,0"
                          Content="List of buttons on the left"
                          IsChecked="{Binding ListOnTheLeft}"
                          ToolTip="The list covers a third of the picture. Put it on the side the picture can spare."
                          AutomationProperties.AutomationId="ListOnTheLeft" />

                <CheckBox Margin="0,8,0,0"
                          Content="Small buttons in the bottom corner"
                          IsChecked="{Binding CornerAtTheBottom}"
                          ToolTip="The music and disc check buttons, and the two below. They sit on the side away from the list, top or bottom."
                          AutomationProperties.AutomationId="CornerAtTheBottom" />

                <CheckBox Margin="0,8,0,0"
                          Content="Disc manual and extras as small buttons"
                          IsChecked="{Binding DiscsOwnAsSmallButtons}"
                          ToolTip="The manual and the extras folder chosen below, as two small buttons on the main menu and not rows in its list. A game's own manual and extras stay on that game's screen."
                          AutomationProperties.AutomationId="DiscsOwnAsSmallButtons" />

                <CheckBox Margin="0,8,0,0"
                          Content="A small button that opens the disc"
                          IsChecked="{Binding OpenTheDiscButton}"
                          ToolTip="Opens the disc in Explorer, for looking at what is on it without leaving the menu."
                          AutomationProperties.AutomationId="OpenTheDiscButton" />

                <TextBlock Style="{StaticResource Aside}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding WhereTheCornerButtonsSit}"
                           AutomationProperties.AutomationId="WhereTheCornerButtonsSit" />

                <!-- ============================================ music, manual -->
                <TextBlock Style="{StaticResource Step}" Margin="0,22,0,0" Text="AND THE REST OF IT" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Music" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Music}"
                               Text="{Binding Music, TargetNullValue=Nothing chosen}"
                               AutomationProperties.AutomationId="TheMusic" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Choose"
                                Style="{StaticResource Ordinary}"
                                Click="ChooseTheMusic"
                                AutomationProperties.AutomationId="ChooseTheMusic" />
                        <Button Content="Clear"
                                Style="{StaticResource Ordinary}"
                                Margin="8,0,0,0"
                                Click="ClearTheMusic"
                                AutomationProperties.AutomationId="ClearTheMusic" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Manual" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Manual}"
                               Text="{Binding Manual, TargetNullValue=Nothing chosen}"
                               AutomationProperties.AutomationId="TheManual" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Choose"
                                Style="{StaticResource Ordinary}"
                                Click="ChooseTheManual"
                                AutomationProperties.AutomationId="ChooseTheManual" />
                        <Button Content="Clear"
                                Style="{StaticResource Ordinary}"
                                Margin="8,0,0,0"
                                Click="ClearTheManual"
                                AutomationProperties.AutomationId="ClearTheManual" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Extras folder" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ExtrasFolder}"
                               Text="{Binding ExtrasFolder, TargetNullValue=Nothing chosen}"
                               AutomationProperties.AutomationId="TheExtrasFolder" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Choose"
                                Style="{StaticResource Ordinary}"
                                Click="ChooseTheExtras"
                                AutomationProperties.AutomationId="ChooseTheExtras" />
                        <Button Content="Clear"
                                Style="{StaticResource Ordinary}"
                                Margin="8,0,0,0"
                                Click="ClearTheExtras"
                                AutomationProperties.AutomationId="ClearTheExtras" />
                    </StackPanel>
                </Grid>

                <!-- =============================================== for printing -->
                <TextBlock Style="{StaticResource Step}" Margin="0,22,0,0" Text="FOR PRINTING" />
                <!-- One row, in a panel 680 wide. It said only the first
                     sentence, which answers what this is NOT for and leaves
                     what it IS for unsaid: the files are copied onto the
                     disc so they can be found and printed later. -->
                <TextBlock Style="{StaticResource Aside}"
                           Margin="0,2,0,6"
                           TextWrapping="NoWrap"
                           Text="Choosing them is not printing them. They go on the disc in an ARTWORK folder to print later." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="52" Height="72"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Edge}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Image Source="{Binding Cover, Converter={StaticResource APicture}}"
                               Stretch="Uniform"
                               Margin="2"
                               AutomationProperties.AutomationId="TheCoverPicture" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                        <TextBlock Text="Cover" />
                        <TextBlock Style="{StaticResource Aside}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Cover}"
                                   Text="{Binding Cover, TargetNullValue=Nothing chosen}"
                                   AutomationProperties.AutomationId="TheCover" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Choose"
                                Style="{StaticResource Ordinary}"
                                Click="ChooseTheCover"
                                AutomationProperties.AutomationId="ChooseTheCover" />
                        <Button Content="Clear"
                                Style="{StaticResource Ordinary}"
                                Margin="8,0,0,0"
                                Click="ClearTheCover"
                                AutomationProperties.AutomationId="ClearTheCover" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Drawn as the disc it will be printed on: round, with the
                        hole in the middle. The picture itself stays square, which
                        is what disc printing software takes, and the software
                        cuts the shape and the hole to suit the printer.

                        A Border's CornerRadius rounds its own background and does
                        not cut what is inside it, so the picture used to sit
                        square over a round frame. The Clip is what makes it round.
                    -->
                    <Border Grid.Column="0" Width="72" Height="72"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Edge}"
                            BorderThickness="1"
                            CornerRadius="36">
                        <Grid Width="66" Height="66">
                            <Image Source="{Binding DiscFace, Converter={StaticResource APicture}}"
                                   Stretch="UniformToFill"
                                   AutomationProperties.AutomationId="TheDiscFacePicture">
                                <Image.Clip>
                                    <EllipseGeometry Center="33,33" RadiusX="33" RadiusY="33" />
                                </Image.Clip>
                            </Image>
                            <Ellipse Width="14" Height="14"
                                     Fill="{DynamicResource Page}"
                                     Stroke="{DynamicResource Edge}"
                                     StrokeThickness="1"
                                     AutomationProperties.AutomationId="TheDiscFaceHole" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                        <TextBlock Text="Disc face" />
                        <TextBlock Style="{StaticResource Aside}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DiscFace}"
                                   Text="{Binding DiscFace, TargetNullValue=Nothing chosen}"
                                   AutomationProperties.AutomationId="TheDiscFace" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Choose"
                                Style="{StaticResource Ordinary}"
                                Click="ChooseTheDiscFace"
                                AutomationProperties.AutomationId="ChooseTheDiscFace" />
                        <Button Content="Clear"
                                Style="{StaticResource Ordinary}"
                                Margin="8,0,0,0"
                                Click="ClearTheDiscFace"
                                AutomationProperties.AutomationId="ClearTheDiscFace" />
                    </StackPanel>
                </Grid>

                <TextBlock Foreground="{DynamicResource WorryInk}"
                           FontSize="12"
                           Margin="0,14,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding WhyNotThatPicture}"
                           Visibility="{Binding WhyNotThatPicture, Converter={StaticResource WhenAnything}}"
                           AutomationProperties.AutomationId="WhyNotThatPicture" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Done"
                Style="{StaticResource TheButton}"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                IsDefault="True"
                Click="Done"
                AutomationProperties.AutomationId="Done" />
    </Grid>
</Window>
