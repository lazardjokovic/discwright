<!--
    No StartupUri. The window is built in code, because it is handed the screen
    it shows and the real file system it reads, and a window WPF constructs for
    itself can be handed nothing.
-->
<Application x:Class="DiscWright.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiscWright.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Look.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:WhenNone x:Key="WhenNone" />
            <local:WhenSo x:Key="WhenSo" />
            <local:WhenNot x:Key="WhenNot" />
            <local:WhenAnything x:Key="WhenAnything" />
            <local:APicture x:Key="APicture" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
