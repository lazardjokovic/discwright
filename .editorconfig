; The naming rules from ARCHITECTURE.md, written so the compiler checks them.
; Visual Studio underlines a violation as you type, and the build refuses it,
; because TreatWarningsAsErrors is on in Directory.Build.props.

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,xml,config,editorconfig,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
; Two trailing spaces are a line break in markdown.
trim_trailing_whitespace = false

[*.{cs,xaml}]
indent_size = 4

[*.cs]

; ---------------------------------------------------------------- style

csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

; One less level of indentation in every file, and no brace to match at the end.
csharp_style_namespace_declarations = file_scoped:warning

; var where the type is obvious from the right hand side, the type where it is not.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

; A field nobody reassigns should say so. This is one of the rules in the note.
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning

; ---------------------------------------------------------------- naming

; what each group of symbols is
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_symbols.types.applicable_kinds = class,struct,enum,delegate
dotnet_naming_symbols.types.applicable_accessibilities = *

dotnet_naming_symbols.members.applicable_kinds = property,method,event
dotnet_naming_symbols.members.applicable_accessibilities = *

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.constants.applicable_accessibilities = *

dotnet_naming_symbols.public_static_fields.applicable_kinds = field
dotnet_naming_symbols.public_static_fields.required_modifiers = static
dotnet_naming_symbols.public_static_fields.applicable_accessibilities = public,internal,protected

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter,local
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *

; how each one is spelled
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_style.camel.capitalization = camel_case

dotnet_naming_style.i_then_pascal.capitalization = pascal_case
dotnet_naming_style.i_then_pascal.required_prefix = I

dotnet_naming_style.underscore_then_camel.capitalization = camel_case
dotnet_naming_style.underscore_then_camel.required_prefix = _

; the rules themselves
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = i_then_pascal

dotnet_naming_rule.types_are_pascal_case.severity = warning
dotnet_naming_rule.types_are_pascal_case.symbols = types
dotnet_naming_rule.types_are_pascal_case.style = pascal

dotnet_naming_rule.members_are_pascal_case.severity = warning
dotnet_naming_rule.members_are_pascal_case.symbols = members
dotnet_naming_rule.members_are_pascal_case.style = pascal

dotnet_naming_rule.constants_are_pascal_case.severity = warning
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal

dotnet_naming_rule.public_static_fields_are_pascal_case.severity = warning
dotnet_naming_rule.public_static_fields_are_pascal_case.symbols = public_static_fields
dotnet_naming_rule.public_static_fields_are_pascal_case.style = pascal

dotnet_naming_rule.private_fields_begin_with_underscore.severity = warning
dotnet_naming_rule.private_fields_begin_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_begin_with_underscore.style = underscore_then_camel

dotnet_naming_rule.locals_and_parameters_are_camel_case.severity = warning
dotnet_naming_rule.locals_and_parameters_are_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_are_camel_case.style = camel

[tests/**/*.cs]
; A test name is a sentence, because a failure should read as one:
;   A_file_too_big_for_any_disc_is_refused_before_anything_is_built
; That is deliberately not PascalCase, so both rules that object are off in
; here and nowhere else. They are two separate mechanisms: the naming style
; below, and the CA1707 analyzer, which does not read naming styles at all.
dotnet_naming_rule.members_are_pascal_case.severity = none
dotnet_diagnostic.CA1707.severity = none
